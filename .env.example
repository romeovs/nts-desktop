# The public Firebase web config NTS ships in its own frontend bundle, used for
# the live tracklist. `make env` writes the real .env by reading it back off
# nts.live, and the build does that automatically when .env is missing, so you
# should not need to fill this in by hand.
FIREBASE_CONFIG={"apiKey":"...","authDomain":"nts-ios-app.firebaseapp.com","projectId":"nts-ios-app","appId":"..."}

# Optional. Signing in as an NTS Supporter unlocks the live tracklist. In a
# packaged build those credentials live in the keychain. Development builds
# read them from here instead, so macOS does not ask to authorise every rebuild.
NTS_EMAIL=
NTS_PASSWORD=
