{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"maxSize": 20971520,
		"includes": [
			"**",
			"!**/*.svg",
			"!dist",
			"!bundle",
			"!src-tauri/target",
			"!src-tauri/gen",
			"!src-tauri/icons"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"formatWithErrors": true,
		"lineWidth": 85
	},
	"javascript": {
		"globals": ["React"],
		"formatter": {
			"semicolons": "asNeeded"
		}
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"a11y": {
				"noSvgWithoutTitle": "off",
				"noStaticElementInteractions": "off",
				"useKeyWithClickEvents": "off",
				"noAccessKey": "error",
				"noAriaHiddenOnFocusable": "error",
				"noAriaUnsupportedElements": "error",
				"useMediaCaption": "off"
			},
			"complexity": {
				"useArrowFunction": "off",
				"noBannedTypes": "off"
			},
			"correctness": {},
			"performance": {
				"noAccumulatingSpread": "off",
				"noDelete": "error"
			},
			"security": {
				"noDangerouslySetInnerHtml": "off"
			},
			"style": {
				"noDefaultExport": "off",
				"noNonNullAssertion": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noArrayIndexKey": "off",
				"noEmptyBlock": "off"
			}
		}
	}
}
